# ===== Scrap Solovera — configurazione (copia in .env) =====

# Password dashboard (login web)
SCRAP_PASSWORD=solovera-scrap-2026
SCRAP_SESSION_SECRET=cambiami-sessione

# Scheduler
SCRAP_DEFAULT_FREQUENCY_HOURS=24
SCRAP_TZ=Europe/Rome

# Anti-bot (delay randomici tra le richieste)
SCRAP_DELAY_MIN=2.5
SCRAP_DELAY_MAX=6.0
SCRAP_MAX_PAGES=3
SCRAP_MAX_ANNUNCI=60
# Proxy opzionale, es. http://user:pass@host:port (lascia vuoto se non serve)
SCRAP_PROXY=
# Gateway anti-bot opzionale (ZenRows-style) per superare DataDome/Cloudflare.
# Es. SCRAP_ANTIBOT_URL=https://api.zenrows.com/v1/ + SCRAP_ANTIBOT_KEY=la_tua_key
# Senza: i monitor girano e gli errori di blocco sono visibili nel Log.
SCRAP_ANTIBOT_URL=
SCRAP_ANTIBOT_KEY=

# Google Maps (gosom)
SCRAP_GMAPS_DEPTH=3
SCRAP_GMAPS_CONCURRENCY=2
SCRAP_GMAPS_TIMEOUT_MIN=10

# ===== Google Sheets (service account) =====
# Inserisci qui il CONTENUTO JSON del service account (tutto su una riga)
# oppure in base64. Senza questa variabile i monitor funzionano (dati in SQLite)
# ma il sync su Google Sheets viene saltato con un errore visibile nel Log.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Email a cui condividere automaticamente lo spreadsheet (es. la tua Gmail)
SCRAP_SHEET_SHARE_EMAIL=
